 namespace blockscale_panel {
 
 using opus::operator""_I;
+
+// The source addresses remain 16-byte aligned. Expose 8-byte alignment to
+// LLVM so it may choose a paired b64 LDS instruction for the same 16 bytes.
+struct __attribute__((packed, aligned(8))) LdsRead16Pair {
+    unsigned long long lo;
+    unsigned long long hi;
+};
+static_assert(sizeof(LdsRead16Pair) == 16 && alignof(LdsRead16Pair) == 8);
+template<class Scalar>
+struct MatrixSmemPair {
+    using scalar_type = Scalar;
+    OPUS_LDS_ADDR char* ptr;
+    __device__ explicit MatrixSmemPair(void* p)
+        : ptr(reinterpret_cast<OPUS_LDS_ADDR char*>(reinterpret_cast<__UINTPTR_TYPE__>(p))) {}
+    template<int Vec> __device__ auto load(int offset) {
+        static_assert(Vec == 16 && sizeof(Scalar) == 1);
+        const auto raw = *reinterpret_cast<const OPUS_LDS_ADDR LdsRead16Pair*>(ptr + offset);
+        return __builtin_bit_cast(opus::vector_t<Scalar, Vec>, raw);
+    }
+    template<int Vec, class Layout, std::enable_if_t<opus::is_layout_v<Layout>, bool> = true>
+    __device__ auto load(const Layout& u) {
+        using LT = opus::layout_load_traits<Layout, Vec>;
+        constexpr int count = decltype(LT::r_elem)::value;
+        const auto offsets = opus::layout_to_offsets<Vec>(u);
+        opus::vector_t<Scalar, Vec * count> r;
+        opus::static_for<count>([&](auto i) {
+            opus::set_slice(r, load<Vec>(offsets[i]),
+                opus::number<i.value * Vec>{}, opus::number<(i.value + 1) * Vec>{});
+        });
+        return r;
+    }
+};
 
