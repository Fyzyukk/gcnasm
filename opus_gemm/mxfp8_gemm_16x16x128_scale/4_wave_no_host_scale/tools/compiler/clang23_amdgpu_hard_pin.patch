   }
 
   assert(Src.isScalar() && "Can't emit an agg store with this method");
-  EmitStoreOfScalar(Src.getScalarVal(), Dst, isInit);
+  llvm::Value *SV = Src.getScalarVal();
+  if (Dst.isSimple() && !AMDGPUPinnedLocals.empty())
