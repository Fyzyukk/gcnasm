+void SIRegisterInfo::updateRegAllocHint(Register Reg, Register NewReg,
+                                        MachineFunction &MF) const {
+  MachineRegisterInfo &MRI = MF.getRegInfo();
+  std::pair<unsigned, Register> OldHint = MRI.getRegAllocationHint(Reg);
+  if (OldHint.first != AMDGPURI::HardPin)
+    return;
+
+  Register Pinned = OldHint.second;
+  if (!Pinned.isPhysical())
+    report_fatal_error("AMDGPU hard-pin hint has a non-physical target");
+
+  if (NewReg.isPhysical()) {
+    if (NewReg != Pinned)
+      report_fatal_error("AMDGPU hard-pinned virtual register was coalesced "
+                         "to a different physical register");
+    return;
+  }
+
+  if (!NewReg.isVirtual())
+    report_fatal_error("AMDGPU hard-pin hint was coalesced to an invalid "
+                       "register");
+
+  std::pair<unsigned, Register> NewHint = MRI.getRegAllocationHint(NewReg);
+  if (NewHint.first == AMDGPURI::HardPin && NewHint.second != Pinned) {
+    // Subregister coalescing legitimately joins an element pinned to (say)
+    // a[8:11] with its REG_SEQUENCE result pinned to a[8:15]. Keep the
+    // surviving register's wider constraint when the physical tuples overlap.
+    if (NewHint.second.isPhysical() &&
+        regsOverlap(Pinned, NewHint.second.asMCReg()))
+      return;
+    report_fatal_error(
+        Twine("conflicting AMDGPU hard-pin hints were coalesced: vreg ") +
+        Twine(Reg.id()) + " -> " + Twine(NewReg.id()) + ", targets " +
+        Twine(Pinned.id()) + " and " + Twine(NewHint.second.id()));
+  }
+
+  MRI.setRegAllocationHint(NewReg, AMDGPURI::HardPin, Pinned);
+}
